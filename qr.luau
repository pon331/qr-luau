@[native, checked] const function PackBitsLine(Out: buffer, OutOff: number, Src: buffer, SrcOff: number, Len: number)
	local J = 0
	local Off = OutOff
	while J + 32 <= Len do
		local Acc = 0
		local Mul = 1
		for K = 0, 7 do
			const Wd = buffer.readu32(Src, SrcOff + J + K * 4)
			Acc += bit32.rshift(bit32.band(Wd, 0x0101_0101) * 0x1020_4080 % 4_294_967_296, 28) * Mul
			Mul *= 16
		end
		buffer.writeu32(Out, Off, Acc)
		Off += 4
		J += 32
	end
	if J < Len then
		local Acc = 0
		local Mul = 1
		for index = J, Len - 1 do
			Acc += buffer.readu8(Src, SrcOff + index) * Mul
			Mul *= 2
		end
		buffer.writeu32(Out, Off, Acc)
	end
end

@[native, checked] const function UnpackBitsLine(Src: buffer, InOff: number, Dst: buffer, DstOff: number, Len: number)
	local J = 0
	local Off = InOff
	while J + 32 <= Len do
		const Acc = buffer.readu32(Src, Off)
		Off += 4
		for K = 0, 7 do
			const N = bit32.band(bit32.rshift(Acc, K * 4), 15)
			buffer.writeu32(Dst, DstOff + J + K * 4, bit32.bor(
				bit32.band(N, 1),
				bit32.band(bit32.lshift(N, 7), 0x100),
				bit32.band(bit32.lshift(N, 14), 0x1_0000),
				bit32.band(bit32.lshift(N, 21), 0x100_0000)
				))
		end
		J += 32
	end
	if J < Len then
		const Acc = buffer.readu32(Src, Off)
		for index = J, Len - 1 do
			buffer.writeu8(Dst, DstOff + index, bit32.band(bit32.rshift(Acc, index - J), 1))
		end
	end
end

@[native, checked] const function SetModuleBit(BM: buffer, WS: number, Row: number, Col: number, V: number)
	const Off = (Row * WS + Col // 32) * 4
	const Bit = bit32.lshift(1, Col % 32)
	const Wd = buffer.readu32(BM, Off)
	buffer.writeu32(BM, Off, if V == 1 then bit32.bor(Wd, Bit) else bit32.band(Wd, bit32.bnot(Bit)))
end

@[native, checked] const function ApplyMaskBits(BM: buffer, INV: buffer, Size: number, WS: number, Mask: number)
	const PatBase = Mask * 288
	for Row = 0, Size - 1 do
		const PatOff = PatBase + (Row % 12) * 24
		const RowOff = Row * WS * 4
		for W = 0, WS - 1 do
			const Flip = bit32.band(buffer.readu32(MASKPAT, PatOff + W * 4), buffer.readu32(INV, RowOff + W * 4))
			buffer.writeu32(BM, RowOff + W * 4, bit32.bxor(buffer.readu32(BM, RowOff + W * 4), Flip))
		end
	end
end

@[native, checked] const function SetModuleBitT(BT: buffer, WS: number, Row: number, Col: number, V: number)
	const Off = (Col * WS + Row // 32) * 4
	const Bit = bit32.lshift(1, Row % 32)
	const Wd = buffer.readu32(BT, Off)
	buffer.writeu32(BT, Off, if V == 1 then bit32.bor(Wd, Bit) else bit32.band(Wd, bit32.bnot(Bit)))
end

@[native, checked] const function ApplyMaskBitsCol(BT: buffer, INVT: buffer, Size: number, WS: number, Mask: number)
	const PatBase = Mask * 288
	for Col = 0, Size - 1 do
		const PatOff = PatBase + (Col % 12) * 24
		const LineOff = Col * WS * 4
		for V = 0, WS - 1 do
			const Flip = bit32.band(buffer.readu32(MASKPAT_COL, PatOff + V * 4), buffer.readu32(INVT, LineOff + V * 4))
			buffer.writeu32(BT, LineOff + V * 4, bit32.bxor(buffer.readu32(BT, LineOff + V * 4), Flip))
		end
	end
end

@[native, checked] const function DrawFormatBitsMask(BM: buffer, Size: number, WS: number, Level: number, Mask: number)
	const Data = bit32.bor(buffer.readu8(LEVEL_FORMAT_BITS, Level) * 8, Mask)
	local Rem = Data
	for _ = 1, 10 do
		Rem = bit32.bxor(Rem * 2, Rem // 512 * FORMAT_GENERATOR)
	end
	const Bits = bit32.bxor(bit32.bor(Data * 1024, Rem), FORMAT_MASK)

	for index = 0, 5 do
		SetModuleBit(BM, WS, index, 8, bit32.band(bit32.rshift(Bits, index), 1))
	end
	SetModuleBit(BM, WS, 7, 8, bit32.band(Bits // 64, 1))
	SetModuleBit(BM, WS, 8, 8, bit32.band(Bits // 128, 1))
	SetModuleBit(BM, WS, 8, 7, bit32.band(Bits // 256, 1))
	for index = 9, 14 do
		SetModuleBit(BM, WS, 8, 14 - index, bit32.band(bit32.rshift(Bits, index), 1))
	end
	for index = 0, 7 do
		SetModuleBit(BM, WS, 8, Size - 1 - index, bit32.band(bit32.rshift(Bits, index), 1))
	end
	for index = 8, 14 do
		SetModuleBit(BM, WS, Size - 15 + index, 8, bit32.band(bit32.rshift(Bits, index), 1))
	end
	SetModuleBit(BM, WS, Size - 8, 8, 1)
end

