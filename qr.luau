@[native, checked] const function BandOf(Version: number): number
	return if Version <= 9 then 0 elseif Version <= 26 then 1 else 2
end

@[native, checked] const function CharCountBits(Mode: number, Version: number): number
	const Band = BandOf(Version)
	if Mode == MODE_NUMERIC then
		return buffer.readu8(CC_NUMERIC, Band)
	elseif Mode == MODE_ALPHANUMERIC then
		return buffer.readu8(CC_ALPHANUMERIC, Band)
	elseif Mode == MODE_KANJI then
		return buffer.readu8(CC_KANJI, Band)
	else
		return buffer.readu8(CC_BYTE, Band)
	end
end

@[native, checked] const function GetNumRawDataModules(Version: number): number
	local Result = (16 * Version + 128) * Version + 64
	if Version >= 2 then
		const NumAlign = Version // 7 + 2
		Result -= (25 * NumAlign - 10) * NumAlign - 55
		if Version >= 7 then
			Result -= 36
		end
	end
	return Result
end

@[native, checked] const function GetNumDataCodewords(Version: number, Level: number): number
	return GetNumRawDataModules(Version) // 8 - buffer.readu8(ECC_CODEWORDS_PER_BLOCK, Level * MAX_VERSION + Version - 1) * buffer.readu8(NUM_ERROR_CORRECTION_BLOCKS, Level * MAX_VERSION + Version - 1)
end

@[native, checked] const function DataBits(Mode: number, Count: number): number
	if Mode == MODE_NUMERIC then
		local Bits = (Count // 3) * 10
		const Remainder = Count % 3
		if Remainder == 1 then
			return Bits + 4
		elseif Remainder == 2 then
			return Bits + 7
		end
		return Bits
	elseif Mode == MODE_ALPHANUMERIC then
		return (Count // 2) * 11 + (Count % 2) * 6
	elseif Mode == MODE_KANJI then
		return Count * 13
	else
		return Count * 8
	end
end

@[native, checked] const function SegmentBits(Seg: buffer, Version: number): number
	const Mode = buffer.readu8(Seg, SEG_MODE)
	if Mode == MODE_ECI then
		const Value = buffer.readu32(Seg, SEG_VALUE)
		if Value < 0x80 then
			return 12
		elseif Value < 0x4000 then
			return 20
		else
			return 28
		end
	end
	const Count = buffer.readu16(Seg, SEG_COUNT)
	const Cc = CharCountBits(Mode, Version)
	if Count >= bit32.lshift(1, Cc) then
		return math.huge
	end
	return 4 + Cc + DataBits(Mode, Count)
end

@[native, checked] const function IsNumeric(Data: buffer, DataLength: number): boolean
	for index = 0, DataLength - 1 do
		const B = buffer.readu8(Data, index)
		if B < 48 or B > 57 then
			return false
		end
	end
	return true
end

@[native, checked] const function IsAlphanumeric(Data: buffer, DataLength: number): boolean
	for index = 0, DataLength - 1 do
		if buffer.readu8(ALPHANUMERIC, buffer.readu8(Data, index)) == 0xFF then
			return false
		end
	end
	return true
end

