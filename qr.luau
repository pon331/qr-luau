@[native, checked] const function Transpose32(Buf: buffer)
	local M = 0x0000_FFFF
	local J = 16
	while J ~= 0 do
		local K = 0
		while K < 32 do
			const X = buffer.readu32(Buf, K * 4)
			const Y = buffer.readu32(Buf, (K + J) * 4)
			const T = bit32.band(bit32.bxor(Y, bit32.rshift(X, J)), M)
			buffer.writeu32(Buf, K * 4, bit32.bxor(X, bit32.lshift(T, J)))
			buffer.writeu32(Buf, (K + J) * 4, bit32.bxor(Y, T))
			K = (K + J + 1) - bit32.band(K + J + 1, J)
		end
		J //= 2
		M = bit32.bxor(M, bit32.lshift(M, J))
	end
end

@[native, checked] const function TransposeAll(Src: buffer, Dst: buffer, Size: number, WS: number, Scr: buffer)
	for RB = 0, WS - 1 do
		for CB = 0, WS - 1 do
			for index = 0, 31 do
				const Row = RB * 32 + index
				buffer.writeu32(Scr, index * 4, if Row < Size then buffer.readu32(Src, (Row * WS + CB) * 4) else 0)
			end
			Transpose32(Scr)
			for index = 0, 31 do
				const Row = CB * 32 + index
				if Row < Size then
					buffer.writeu32(Dst, (Row * WS + RB) * 4, buffer.readu32(Scr, index * 4))
				end
			end
		end
	end
end

@[native, checked] const function RunScan(BM: buffer, Off: number, Size: number, WS: number, TailMask: number, CountDark: boolean): (number, number)
	local P = 0
	local Dark = 0
	local PrevPos = 0
	local Carry = 0
	local LB = 0
	local H1 = 0
	local H2 = 0
	local H3 = 0
	local H4 = 0
	local H5 = 0
	local H6 = 0
	local H7 = 0
	local First = true
	local RunColor = 0
	for W = 0, WS - 1 do
		const X = buffer.readu32(BM, Off + W * 4)
		if CountDark then
			local C = X - bit32.band(bit32.rshift(X, 1), 0x5555_5555)
			C = bit32.band(C, 0x3333_3333) + bit32.band(bit32.rshift(C, 2), 0x3333_3333)
			C = bit32.band(C + bit32.rshift(C, 4), 0x0F0F_0F0F)
			Dark += (C * 0x0101_0101) // 16_777_216 % 256
		end
		local E = bit32.bxor(X, bit32.bor(bit32.lshift(X, 1), Carry))
		Carry = bit32.rshift(X, 31)
		if W == WS - 1 then
			E = bit32.band(E, TailMask)
		end
		const Base = W * 32
		while E ~= 0 do
			const Pos = Base + bit32.countrz(E)
			local Len = Pos - PrevPos
			if Len >= 5 then
				P += PENALTY_N1 + Len - 5
			end
			if RunColor == 0 then
				if First then
					Len += Size
					First = false
				end
				H7 = H5
				H6 = H4
				H5 = H3
				H4 = H2
				H3 = H1
				H2 = LB
				H1 = Len
				local N = H2
				if N > 0 and H3 == N and H4 == 3 * N and H5 == N and H6 == N then
					if H1 >= 4 * N and H7 >= N then
						P += PENALTY_N3
					end
					if H7 >= 4 * N and H1 >= N then
						P += PENALTY_N3
					end
				end
				RunColor = 1
			else
				LB = Len
				RunColor = 0
			end
			PrevPos = Pos
			E = bit32.band(E, E - 1)
		end
	end
	const Len = Size - PrevPos
	if Len >= 5 then
		P += PENALTY_N1 + Len - 5
	end
	H7 = H5
	H6 = H4
	H5 = H3
	H4 = H2
	H3 = H1
	if RunColor ~= 0 then
		H2 = Len
		H1 = Size
	else
		H2 = LB
		H1 = Len + Size
		if First then
			H1 += Size
		end
	end
	const N = H2
	if N > 0 and H3 == N and H4 == 3 * N and H5 == N and H6 == N then
		if H1 >= 4 * N and H7 >= N then
			P += PENALTY_N3
		end
		if H7 >= 4 * N and H1 >= N then
			P += PENALTY_N3
		end
	end
	return P, Dark
end

@[native, checked] const function PenaltyBits(BM: buffer, BT: buffer, Size: number, WS: number, Budget: number, Scr: buffer): number
	local Result = 0
	local Dark = 0
	const LastBits = Size - (WS - 1) * 32
	const TailMask = bit32.band(bit32.lshift(1, LastBits) - 1, 0xFFFF_FFFF)
	for Row = 0, Size - 1 do
		local P, D = RunScan(BM, Row * WS * 4, Size, WS, TailMask, true)
		Result += P
		Dark += D
	end
	if Result >= Budget then
		return Result
	end

	local TailEH = 0
	if LastBits < 32 then
		TailEH = bit32.band(bit32.lshift(1, LastBits - 1) - 1, 0xFFFF_FFFF)
	end
	do
		local A = buffer.readu32(BT, 0)
		for V = 0, WS - 1 do
			const Nxt = if V < WS - 1 then buffer.readu32(BT, (V + 1) * 4) else 0
			local H = bit32.bnot(bit32.bxor(A, bit32.bor(bit32.rshift(A, 1), bit32.lshift(bit32.band(Nxt, 1), 31))))
			if V == WS - 1 and LastBits < 32 then
				H = bit32.band(H, TailEH)
			end
			buffer.writeu32(Scr, V * 4, H)
			A = Nxt
		end
	end
	for Col = 1, Size - 1 do
		const Off = Col * WS * 4
		const OffP = Off - WS * 4
		local A = buffer.readu32(BT, Off)
		for V = 0, WS - 1 do
			const Nxt = if V < WS - 1 then buffer.readu32(BT, Off + (V + 1) * 4) else 0
			local H = bit32.bnot(bit32.bxor(A, bit32.bor(bit32.rshift(A, 1), bit32.lshift(bit32.band(Nxt, 1), 31))))
			if V == WS - 1 and LastBits < 32 then
				H = bit32.band(H, TailEH)
			end
			const EQ = bit32.band(H, buffer.readu32(Scr, V * 4), bit32.bnot(bit32.bxor(A, buffer.readu32(BT, OffP + V * 4))))
			buffer.writeu32(Scr, V * 4, H)
			A = Nxt
			local C = EQ - bit32.band(bit32.rshift(EQ, 1), 0x5555_5555)
			C = bit32.band(C, 0x3333_3333) + bit32.band(bit32.rshift(C, 2), 0x3333_3333)
			C = bit32.band(C + bit32.rshift(C, 4), 0x0F0F_0F0F)
			Result += 3 * ((C * 0x0101_0101) // 16_777_216 % 256)
		end
	end
	if Result >= Budget then
		return Result
	end

	for Col = 0, Size - 1 do
		const P = RunScan(BT, Col * WS * 4, Size, WS, TailMask, false)
		Result += P
	end

	const Total = Size * Size
	const K = math.ceil(math.abs(Dark * 20.0 - Total * 10.0) / Total) - 1
	Result += K * PENALTY_N4

	return Result
end

@[native, checked] const function BuildSymbol(Version: number, Level: number, Codewords: buffer, ForcedMask: number): (buffer, number)
	const Size = Version * 4 + 17
	const Modules = buffer.create(Size * Size)
	const IsFunction = buffer.create(Size * Size)

	for index = 0, Size - 1 do
		buffer.writeu8(IsFunction, 6 * Size + index, 1)
		buffer.writeu8(IsFunction, index * Size + 6, 1)
		if index % 2 == 0 then
			buffer.writeu8(Modules, 6 * Size + index, 1)
			buffer.writeu8(Modules, index * Size + 6, 1)
		end
	end

	DrawFinder(Modules, IsFunction, Size, 3, 3)
	DrawFinder(Modules, IsFunction, Size, Size - 4, 3)
	DrawFinder(Modules, IsFunction, Size, 3, Size - 4)

	const Count = buffer.readu8(ALIGNMENT, Version * 8)
	const Slot = Version * 8
	for index = 0, Count - 1 do
		for inner_index = 0, Count - 1 do
			if not (index == 0 and inner_index == 0 or index == 0 and inner_index == Count - 1 or index == Count - 1 and inner_index == 0) then
				DrawAlignment(Modules, IsFunction, Size, buffer.readu8(ALIGNMENT, Slot + index + 1), buffer.readu8(ALIGNMENT, Slot + inner_index + 1))
			end
		end
	end

	DrawFormatBits(Modules, IsFunction, Size, Level, 0)
	DrawVersion(Modules, IsFunction, Size, Version)
	DrawCodewords(Modules, IsFunction, Size, Codewords)

	const WS = (Size + 31) // 32
	const LastBits = Size - (WS - 1) * 32
	const BM = buffer.create(Size * WS * 4)
	const INV = buffer.create(Size * WS * 4)
	const Scr = buffer.create(128)
	for Row = 0, Size - 1 do
		PackBitsLine(BM, Row * WS * 4, Modules, Row * Size, Size)
		PackBitsLine(INV, Row * WS * 4, IsFunction, Row * Size, Size)
	end
	for index = 0, Size * WS - 1 do
		buffer.writeu32(INV, index * 4, bit32.bnot(buffer.readu32(INV, index * 4)))
	end
	if LastBits < 32 then
		const TailMask = bit32.lshift(1, LastBits) - 1
		for Row = 0, Size - 1 do
			const Off = (Row * WS + WS - 1) * 4
			buffer.writeu32(INV, Off, bit32.band(buffer.readu32(INV, Off), TailMask))
		end
	end

	local Mask = 0
	if ForcedMask < 0 then
		const BaseModules = buffer.create(Size * WS * 4)
		const BT = buffer.create(Size * WS * 4)
		const BTB = buffer.create(Size * WS * 4)
		const INVT = buffer.create(Size * WS * 4)
		buffer.copy(BaseModules, 0, BM, 0, Size * WS * 4)
		TransposeAll(BM, BTB, Size, WS, Scr)
		TransposeAll(INV, INVT, Size, WS, Scr)
		local BestPenalty = math.huge
		for Candidate = 0, 7 do
			buffer.copy(BM, 0, BaseModules, 0, Size * WS * 4)
			buffer.copy(BT, 0, BTB, 0, Size * WS * 4)
			ApplyMaskBits(BM, INV, Size, WS, Candidate)
			ApplyMaskBitsCol(BT, INVT, Size, WS, Candidate)
			DrawFormatBitsMask(BM, Size, WS, Level, Candidate)
			DrawFormatBitsMaskT(BT, Size, WS, Level, Candidate)
			const Penalty = PenaltyBits(BM, BT, Size, WS, BestPenalty, Scr)
			if Penalty < BestPenalty then
				BestPenalty = Penalty
				Mask = Candidate
			end
		end
		buffer.copy(BM, 0, BaseModules, 0, Size * WS * 4)
	else
		Mask = ForcedMask
	end

	ApplyMaskBits(BM, INV, Size, WS, Mask)
	DrawFormatBitsMask(BM, Size, WS, Level, Mask)

	for Row = 0, Size - 1 do
		UnpackBitsLine(BM, Row * WS * 4, Modules, Row * Size, Size)
	end

	return Modules, Mask
end

@[native, checked] const function Utf8Length(First: number): number
	if First < 0x80 then
		return 1
	elseif First < 0xE0 then
		return 2
	elseif First < 0xF0 then
		return 3
	else
		return 4
	end
end

@[native, checked] const function DecodeCodepoint(Data: buffer, Position: number, Length: number): number
	const B0 = buffer.readu8(Data, Position)
	if Length == 1 then
		return B0
	end
	const B1 = buffer.readu8(Data, Position + 1)
	if Length == 2 then
		return bit32.band(B0, 0x1F) * 64 + bit32.band(B1, 0x3F)
	end
	const B2 = buffer.readu8(Data, Position + 2)
	if Length == 3 then
		return bit32.band(B0, 0x0F) * 4096 + bit32.band(B1, 0x3F) * 64 + bit32.band(B2, 0x3F)
	end
	const B3 = buffer.readu8(Data, Position + 3)
	return bit32.band(B0, 0x07) * 262_144 + bit32.band(B1, 0x3F) * 4096 + bit32.band(B2, 0x3F) * 64 + bit32.band(B3, 0x3F)
end

@[native, checked] const function IsKanjiPreferred(Codepoint: number): boolean
	return (Codepoint >= 0x3000 and Codepoint <= 0x303F) or (Codepoint >= 0x3040 and Codepoint <= 0x309F) or (Codepoint >= 0x30A0 and Codepoint <= 0x30FF) or (Codepoint >= 0x31F0 and Codepoint <= 0x31FF) or (Codepoint >= 0x3400 and Codepoint <= 0x4DBF) or (Codepoint >= 0x4E00 and Codepoint <= 0x9FFF) or (Codepoint >= 0xF900 and Codepoint <= 0xFAFF) or (Codepoint >= 0xFF00 and Codepoint <= 0xFFEF)
end

@[native, checked] const function Precompute(Data: buffer, DataLength: number, LastNonNum: buffer, LastNonAlnum: buffer, LastNonKanji: buffer, CharIdx: buffer, CharStart: buffer, IsCharStart: buffer)
	local NumBoundary = 0
	local AlnumBoundary = 0
	local KanjiBoundary = 0
	local CharCount = 0

	local Position = 0
	while Position < DataLength do
		const First = buffer.readu8(Data, Position)
		const Length = math.min(Utf8Length(First), DataLength - Position)
		const IsDigit = First >= 48 and First <= 57
		const IsAlnum = buffer.readu8(ALPHANUMERIC, First) ~= 0xFF
		local IsKanji = false
		if Length > 1 then
			const Cp = DecodeCodepoint(Data, Position, Length)
			IsKanji = IsKanjiPreferred(Cp) and KanjiValue(Cp) ~= 0
		end

		for index = 0, Length - 1 do
			buffer.writeu8(IsCharStart, Position + index, if index == 0 then 1 else 0)
			buffer.writeu16(CharIdx, (Position + index) * 2, CharCount)
		end
		buffer.writeu16(CharStart, CharCount * 2, Position)
		CharCount += 1

		if not IsDigit then
			NumBoundary = Position + Length
		end
		if not IsAlnum then
			AlnumBoundary = Position + Length
		end
		if not IsKanji then
			KanjiBoundary = Position + Length
		end

		for inner_index = Position + 1, Position + Length do
			buffer.writeu16(LastNonNum, inner_index * 2, NumBoundary)
			buffer.writeu16(LastNonAlnum, inner_index * 2, AlnumBoundary)
			buffer.writeu16(LastNonKanji, inner_index * 2, KanjiBoundary)
		end

		Position += Length
	end
end

@[native, checked] const function MakeSegment(Mode: number, Data: buffer, Count: number, Value: number): buffer
	const Seg = buffer.create(SEG_DATA + buffer.len(Data))
	buffer.writeu8(Seg, SEG_MODE, Mode)
	buffer.writeu16(Seg, SEG_COUNT, Count)
	buffer.writeu32(Seg, SEG_VALUE, Value)
	buffer.copy(Seg, SEG_DATA, Data, 0, buffer.len(Data))
	return Seg
end

local ScrLastNonNum: buffer, ScrLastNonAlnum: buffer, ScrLastNonKanji: buffer
local ScrCharIdx: buffer, ScrCharStart: buffer, ScrIsCharStart: buffer
local ScrCost: buffer, ScrPrevMode: buffer, ScrPrevStart: buffer
local ScrByteDQ: buffer, ScrKanjiDQ: buffer
local ScrNum1: buffer, ScrNum2: buffer, ScrNum3: buffer
local ScrAlnum1: buffer, ScrAlnum2: buffer
local ScrN = -1

@[native, checked] const function ScratchEnsure(DataLength: number)
	if DataLength > ScrN then
		const Cap = if DataLength < 64 then 64 else bit32.lshift(1, 32 - bit32.countlz(DataLength))
		ScrLastNonNum = buffer.create((Cap + 1) * 2)
		ScrLastNonAlnum = buffer.create((Cap + 1) * 2)
		ScrLastNonKanji = buffer.create((Cap + 1) * 2)
		ScrCharIdx = buffer.create((Cap + 1) * 2)
		ScrCharStart = buffer.create((Cap + 1) * 2)
		ScrIsCharStart = buffer.create(Cap + 1)
		ScrCost = buffer.create((Cap + 1) * 4)
		ScrPrevMode = buffer.create(Cap)
		ScrPrevStart = buffer.create(Cap * 2)
		const DC = 12 + (Cap + 1) * 8
		ScrByteDQ = buffer.create(DC)
		ScrKanjiDQ = buffer.create(DC)
		ScrNum1 = buffer.create(DC)
		ScrNum2 = buffer.create(DC)
		ScrNum3 = buffer.create(DC)
		ScrAlnum1 = buffer.create(DC)
		ScrAlnum2 = buffer.create(DC)
		ScrN = Cap
	end
end

@[native, checked] const function OptimizeSegments(Data: buffer, DataLength: number, Band: number,LastNonNum: buffer, LastNonAlnum: buffer, LastNonKanji: buffer, CharIdx: buffer, CharStart: buffer, IsCharStart: buffer): ({ buffer }, number)
	ScratchEnsure(DataLength)
	const Cost = ScrCost
	const PrevMode = ScrPrevMode
	const PrevStart = ScrPrevStart

	const ByteDQ = ScrByteDQ
	const KanjiDQ = ScrKanjiDQ
	local DqBH, DqBT = 0, 1
	local DqKH, DqKT = 0, 1
	local DqN1H, DqN1T, DqN2H, DqN2T, DqN3H, DqN3T = 0, 1, 0, 0, 0, 0
	local DqA1H, DqA1T, DqA2H, DqA2T = 0, 1, 0, 0

	const CCn = buffer.readu8(CC_NUMERIC, Band)
	const CCa = buffer.readu8(CC_ALPHANUMERIC, Band)
	const CCb = buffer.readu8(CC_BYTE, Band)
	const CCk = buffer.readu8(CC_KANJI, Band)
	const CapNum = bit32.lshift(1, CCn) - 1
	const CapAlnum = bit32.lshift(1, CCa) - 1
	const CapByte = bit32.lshift(1, CCb) - 1
	const CapKanji = bit32.lshift(1, CCk) - 1
	const Hn = 4 + CCn
	const Ha = 4 + CCa
	const Hb = 4 + CCb
	const Hk = 4 + CCk

	const Cap = DataLength + 1
	const IdxOff = 12 + Cap * 4
	buffer.writeu32(Cost, 0, 0)
	buffer.writei32(ByteDQ, 12, 0)
	buffer.writeu32(ByteDQ, IdxOff, 0)
	buffer.writei32(KanjiDQ, 12, 0)
	buffer.writeu32(KanjiDQ, IdxOff, 0)
	do
		local Dq = ScrNum1
		buffer.writei32(Dq, 12, 0)
		buffer.writeu32(Dq, IdxOff, 0)
		Dq = ScrAlnum1
		buffer.writei32(Dq, 12, 0)
		buffer.writeu32(Dq, IdxOff, 0)
	end

	for inner_index = 1, DataLength do
		local Best = 0xFFFF_FFFF
		local BestMode = 0
		local BestStart = 0

		do
			const PopUpTo = inner_index - CapByte - 1
			while DqBH < DqBT do
				if buffer.readu32(ByteDQ, IdxOff + DqBH * 4) > PopUpTo then
					break
				end
				DqBH += 1
			end
			if DqBH < DqBT then
				const C = buffer.readi32(ByteDQ, 12 + DqBH * 4) + Hb + 8 * inner_index
				if C < Best then
					Best = C
					BestMode = MODE_BYTE
					BestStart = buffer.readu32(ByteDQ, IdxOff + DqBH * 4)
				end
			end
		end

		do
			const PopUpTo = math.max(buffer.readu16(LastNonNum, inner_index * 2), inner_index - CapNum) - 1
			for residue = 0, 2 do
				local Dq: buffer
				local DqH: number
				local DqT: number
				if residue == 0 then
					DqH, DqT, Dq = DqN1H, DqN1T, ScrNum1
				elseif residue == 1 then
					DqH, DqT, Dq = DqN2H, DqN2T, ScrNum2
				else
					DqH, DqT, Dq = DqN3H, DqN3T, ScrNum3
				end
				while DqH < DqT do
					if buffer.readu32(Dq, IdxOff + DqH * 4) > PopUpTo then
						break
					end
					DqH += 1
				end
				if DqH < DqT then
					const Delta = (inner_index - residue) % 3
					const D = if Delta == 0 then 0 elseif Delta == 1 then 2 else 1
					const C = (3 * Hn + 10 * inner_index + buffer.readi32(Dq, 12 + DqH * 4) + D) // 3
					if C < Best then
						Best = C
						BestMode = MODE_NUMERIC
						BestStart = buffer.readu32(Dq, IdxOff + DqH * 4)
					end
				end
				if residue == 0 then
					DqN1H = DqH
				elseif residue == 1 then
					DqN2H = DqH
				else
					DqN3H = DqH
				end
			end
		end

		do
			const PopUpTo = math.max(buffer.readu16(LastNonAlnum, inner_index * 2), inner_index - CapAlnum) - 1
			for parity = 0, 1 do
				local Dq: buffer
				local DqH: number
				local DqT: number
				if parity == 0 then
					DqH, DqT, Dq = DqA1H, DqA1T, ScrAlnum1
				else
					DqH, DqT, Dq = DqA2H, DqA2T, ScrAlnum2
				end
				while DqH < DqT do
					if buffer.readu32(Dq, IdxOff + DqH * 4) > PopUpTo then
						break
					end
					DqH += 1
				end
				if DqH < DqT then
					const D = (inner_index - parity) % 2
					const C = (2 * Ha + 11 * inner_index + buffer.readi32(Dq, 12 + DqH * 4) + D) // 2
					if C < Best then
						Best = C
						BestMode = MODE_ALPHANUMERIC
						BestStart = buffer.readu32(Dq, IdxOff + DqH * 4)
					end
				end
				if parity == 0 then
					DqA1H = DqH
				else
					DqA2H = DqH
				end
			end
		end

		if buffer.readu8(IsCharStart, inner_index) ~= 0 then
			local PopUpTo = buffer.readu16(LastNonKanji, inner_index * 2)
			const JChar = buffer.readu16(CharIdx, inner_index * 2)
			if JChar >= CapKanji then
				const Bound = buffer.readu16(CharStart, (JChar - CapKanji) * 2)
				if Bound > PopUpTo then
					PopUpTo = Bound
				end
			end
			PopUpTo -= 1
			while DqKH < DqKT do
				if buffer.readu32(KanjiDQ, IdxOff + DqKH * 4) > PopUpTo then
					break
				end
				DqKH += 1
			end
			if DqKH < DqKT then
				const C = buffer.readi32(KanjiDQ, 12 + DqKH * 4) + Hk + 13 * JChar
				if C < Best then
					Best = C
					BestMode = MODE_KANJI
					BestStart = buffer.readu32(KanjiDQ, IdxOff + DqKH * 4)
				end
			end
		end

		buffer.writeu32(Cost, inner_index * 4, Best)
		if Best < 0xFFFF_FFFF then
			buffer.writeu8(PrevMode, inner_index - 1, BestMode)
			buffer.writeu16(PrevStart, (inner_index - 1) * 2, BestStart)
			do
				const Value = Best - 8 * inner_index
				while DqBT > DqBH do
					if buffer.readi32(ByteDQ, 12 + (DqBT - 1) * 4) < Value then
						break
					end
					DqBT -= 1
				end
				DqBT += 1
				buffer.writei32(ByteDQ, 12 + (DqBT - 1) * 4, Value)
				buffer.writeu32(ByteDQ, IdxOff + (DqBT - 1) * 4, inner_index)
			end
			do
				const R = inner_index % 3
				const Value = 3 * Best - 10 * inner_index
				local DqH: number
				local DqT: number
				if R == 0 then
					DqH, DqT = DqN1H, DqN1T
				elseif R == 1 then
					DqH, DqT = DqN2H, DqN2T
				else
					DqH, DqT = DqN3H, DqN3T
				end
				local Dq: buffer
				if R == 0 then
					Dq = ScrNum1
				elseif R == 1 then
					Dq = ScrNum2
				else
					Dq = ScrNum3
				end
				while DqT > DqH do
					if buffer.readi32(Dq, 12 + (DqT - 1) * 4) < Value then
						break
					end
					DqT -= 1
				end
				DqT += 1
				buffer.writei32(Dq, 12 + (DqT - 1) * 4, Value)
				buffer.writeu32(Dq, IdxOff + (DqT - 1) * 4, inner_index)
				if R == 0 then
					DqN1T = DqT
				elseif R == 1 then
					DqN2T = DqT
				else
					DqN3T = DqT
				end
			end
			do
				const R = inner_index % 2
				const Value = 2 * Best - 11 * inner_index
				local DqH: number
				local DqT: number
				if R == 0 then
					DqH, DqT = DqA1H, DqA1T
				else
					DqH, DqT = DqA2H, DqA2T
				end
				local Dq: buffer
				if R == 0 then
					Dq = ScrAlnum1
				else
					Dq = ScrAlnum2
				end
				while DqT > DqH do
					if buffer.readi32(Dq, 12 + (DqT - 1) * 4) < Value then
						break
					end
					DqT -= 1
				end
				DqT += 1
				buffer.writei32(Dq, 12 + (DqT - 1) * 4, Value)
				buffer.writeu32(Dq, IdxOff + (DqT - 1) * 4, inner_index)
				if R == 0 then
					DqA1T = DqT
				else
					DqA2T = DqT
				end
			end
			if buffer.readu8(IsCharStart, inner_index) ~= 0 then
				const Value = Best - 13 * buffer.readu16(CharIdx, inner_index * 2)
				while DqKT > DqKH do
					if buffer.readi32(KanjiDQ, 12 + (DqKT - 1) * 4) < Value then
						break
					end
					DqKT -= 1
				end
				DqKT += 1
				buffer.writei32(KanjiDQ, 12 + (DqKT - 1) * 4, Value)
				buffer.writeu32(KanjiDQ, IdxOff + (DqKT - 1) * 4, inner_index)
			end
		end
	end
	local Segments: { buffer }
	local N = 0
	do
		local P = DataLength
		while P > 0 do
			N += 1
			P = buffer.readu16(PrevStart, (P - 1) * 2)
		end
		Segments = table.create(N) :: { buffer }
	end
	local inner_index = DataLength
	while inner_index > 0 do
		const Mode = buffer.readu8(PrevMode, inner_index - 1)
		const Start = buffer.readu16(PrevStart, (inner_index - 1) * 2)
		local Seg: buffer
		if Mode == MODE_KANJI then
			const KanjiCount = buffer.readu16(CharIdx, inner_index * 2) - buffer.readu16(CharIdx, Start * 2)
			const KanjiData = buffer.create(KanjiCount * 2)
			local char_cursor = Start
			local KIndex = 0
			while char_cursor < inner_index do
				const Length = math.min(Utf8Length(buffer.readu8(Data, char_cursor)), inner_index - char_cursor)
				buffer.writeu16(KanjiData, KIndex * 2, KanjiValue(DecodeCodepoint(Data, char_cursor, Length)))
				KIndex += 1
				char_cursor += Length
			end
			Seg = MakeSegment(MODE_KANJI, KanjiData, KanjiCount, 0)
		else
			const SegData = buffer.create(inner_index - Start)
			buffer.copy(SegData, 0, Data, Start, inner_index - Start)
			Seg = MakeSegment(Mode, SegData, inner_index - Start, 0)
		end
		inner_index = Start
		Segments[N] = Seg
		N -= 1
	end
	return Segments, buffer.readu32(Cost, DataLength * 4)
end

@[native, checked] const function MakeNumeric(Data: buffer): buffer
	if not IsNumeric(Data, buffer.len(Data)) then
		error("Data is not numeric")
	end
	return MakeSegment(MODE_NUMERIC, Data, buffer.len(Data), 0)
end

@[native, checked] const function MakeAlphanumeric(Data: buffer): buffer
	if not IsAlphanumeric(Data, buffer.len(Data)) then
		error("Data is not alphanumeric")
	end
	return MakeSegment(MODE_ALPHANUMERIC, Data, buffer.len(Data), 0)
end

@[native, checked] const function MakeBytes(Data: buffer): buffer
	return MakeSegment(MODE_BYTE, Data, buffer.len(Data), 0)
end

@[native, checked] const function MakeKanji(Data: buffer): buffer
	const Buf = buffer.create(buffer.len(Data) * 2)
	local Count = 0
	local Position = 0
	while Position < buffer.len(Data) do
		const Length = math.min(Utf8Length(buffer.readu8(Data, Position)), buffer.len(Data) - Position)
		const Sjis = KanjiValue(DecodeCodepoint(Data, Position, Length))
		if Sjis == 0 then
			error("Data contains a character not encodable in Kanji mode")
		end
		buffer.writeu16(Buf, Count * 2, Sjis)
		Count += 1
		Position += Length
	end
	return MakeSegment(MODE_KANJI, Buf, Count, 0)
end

@[native, checked] const function Render(Modules: buffer, Size: number, BlockSize: number, Margin: number): buffer
	const PixelScale = math.max(1, math.floor(BlockSize))
	const MarginModules = math.max(0, math.floor(Margin))
	const PixelSize = (Size + MarginModules * 2) * PixelScale
	const Pixels = buffer.create(PixelSize * PixelSize * 4)
	const RowBytes = PixelSize * 4
	const ScaleBytes = PixelScale * 4
	const MarginPx = MarginModules * PixelScale
	local DestOffset = 0
	if MarginPx > 0 then
		buffer.fill(Pixels, 0, 0xFF, RowBytes)
		local Copied = 1
		while Copied < MarginPx do
			const Chunk = math.min(Copied, MarginPx - Copied)
			buffer.copy(Pixels, Copied * RowBytes, Pixels, 0, Chunk * RowBytes)
			Copied += Chunk
		end
		DestOffset = MarginPx * RowBytes
	end
	for ModuleY = 0, Size - 1 do
		buffer.fill(Pixels, DestOffset, 0xFF, RowBytes)
		const RowBase = ModuleY * Size
		local Off = DestOffset + MarginModules * ScaleBytes
		for ModuleX = 0, Size - 1 do
			if buffer.readu8(Modules, RowBase + ModuleX) ~= 0 then
				for K = 0, ScaleBytes - 4, 4 do
					buffer.writeu32(Pixels, Off + K, 0xFF00_0000)
				end
			end
			Off += ScaleBytes
		end
		local Copied = 1
		while Copied < PixelScale do
			const Chunk = math.min(Copied, PixelScale - Copied)
			buffer.copy(Pixels, DestOffset + Copied * RowBytes, Pixels, DestOffset, Chunk * RowBytes)
			Copied += Chunk
		end
		DestOffset += PixelScale * RowBytes
	end
	if MarginPx > 0 then
		local Copied = 0
		while Copied < MarginPx do
			const Chunk = math.min(if Copied == 0 then MarginPx else Copied, MarginPx - Copied)
			buffer.copy(Pixels, DestOffset + Copied * RowBytes, Pixels, 0, Chunk * RowBytes)
			Copied += Chunk
		end
	end
	return Pixels
end

@[native, checked] const function ResolveRender(BlockSize: number?, Margin: number?): (number, number)
	return math.max(1, math.floor(BlockSize or 4)), math.max(0, math.floor(Margin or 4))
end

@[native, checked] const function FinishRaw(Version: number, Level: number, Segments: { buffer }, ForcedMask: number): (buffer, number, number)
	const Codewords = BuildDataCodewords(Segments, Version, Level)
	const AllCodewords = AddECC(Codewords, Version, Level)
	const Modules, Mask = BuildSymbol(Version, Level, AllCodewords, ForcedMask)
	return Modules, Version * 4 + 17, Mask
end

@[native, checked] const function SegmentsCore(Seg: buffer, Level: number, MinVersion: number, MaxVersion: number, ForcedMask: number, BoostECC: boolean): (buffer, number, number, number, number)
	local Version = -1
	for Candidate = MinVersion, MaxVersion do
		if SegmentBits(Seg, Candidate) <= GetNumDataCodewords(Candidate, Level) * 8 then
			Version = Candidate
			break
		end
	end
	if Version == -1 then
		error("QR data too long")
	end

	if BoostECC then
		for Candidate = Level + 1, 3 do
			if SegmentBits(Seg, Version) <= GetNumDataCodewords(Version, Candidate) * 8 then
				Level = Candidate
			end
		end
	end

	const Modules, Size, Mask = FinishRaw(Version, Level, { Seg }, ForcedMask)
	return Modules, Size, Version, Level, Mask
end

const ECCLevels = table.freeze({
	L = 0,
	M = 1,
	Q = 2
}) :: {
	read L: number,
	read M: number,
	read Q: number,
	[string]: number?
} 

@[native, checked] const function EncodeCore(Data: buffer, Options: EncodeOptions?): (buffer, number, number, number, number)
	local ECC = "M"
	local MinVersion = MIN_VERSION
	local MaxVersion = MAX_VERSION
	local ForcedMask = -1
	local ModeName = "Auto"
	local BoostECC = true

	if Options then
		if Options.ECC then
			ECC = Options.ECC
		end
		if Options.MinVersion then
			MinVersion = Options.MinVersion
		end
		if Options.MaxVersion then
			MaxVersion = Options.MaxVersion
		end
		if Options.Mask then
			ForcedMask = Options.Mask
		end
		if Options.Mode then
			ModeName = Options.Mode
		end
		if Options.BoostECC ~= nil then
			BoostECC = Options.BoostECC
		end
	end

	if MinVersion < MIN_VERSION or MaxVersion > MAX_VERSION or MinVersion > MaxVersion then
		error("Invalid QR version range")
	end
	if ForcedMask < -1 or ForcedMask > 7 then
		error("Invalid QR mask")
	end

	local Level = ECCLevels[ECC] or 3

	if ModeName == "Auto" then
		const DataBuffer = Data
		const DataLength = buffer.len(Data)

		ScratchEnsure(DataLength)
		const LastNonNum = ScrLastNonNum
		const LastNonAlnum = ScrLastNonAlnum
		const LastNonKanji = ScrLastNonKanji
		const CharIdx = ScrCharIdx
		const CharStart = ScrCharStart
		const IsCharStart = ScrIsCharStart
		if DataLength > 0 then
			Precompute(DataBuffer, DataLength, LastNonNum, LastNonAlnum, LastNonKanji, CharIdx, CharStart, IsCharStart)
		end
		buffer.writeu8(IsCharStart, DataLength, 0)
		buffer.writeu16(CharIdx, DataLength * 2, 0)

		local Digits = 0
		local AlnumCount = 0
		local HighBytes = 0
		local OtherBytes = 0
		for index = 0, DataLength - 1 do
			const B = buffer.readu8(DataBuffer, index)
			if B >= 48 and B <= 57 then
				Digits += 1
			elseif buffer.readu8(ALPHANUMERIC, B) ~= 0xFF then
				AlnumCount += 1
			elseif B >= 0x80 then
				HighBytes += 1
			else
				OtherBytes += 1
			end
		end
		const LBDigits = (Digits // 3) * 10 + (Digits % 3) * 4
		const LBAlnum = (AlnumCount // 2) * 11 + (AlnumCount % 2) * 6
		const LBHigh = (HighBytes * 13) // 3
		const LBOther = OtherBytes * 8
		const LBData = LBDigits + LBAlnum + LBHigh + LBOther

		local BestSegments: { buffer } = {}
		local BestBits = math.huge
		local Version = -1
		for Band = 0, 2 do
			const Lo = math.max(buffer.readu8(BAND_START, Band), MinVersion)
			const Hi = math.min(buffer.readu8(BAND_END, Band), MaxVersion)
			if Lo <= Hi then
				if buffer.readu8(LB_HEADER, Band) + LBData <= GetNumDataCodewords(Hi, Level) * 8 then
					local Segs: { buffer } = {}
					local Bits = 0
					if DataLength > 0 then
						Segs, Bits = OptimizeSegments(DataBuffer, DataLength, Band, LastNonNum, LastNonAlnum, LastNonKanji, CharIdx, CharStart, IsCharStart)
					end
					for Candidate = Lo, Hi do
						if Bits <= GetNumDataCodewords(Candidate, Level) * 8 then
							Version = Candidate
							BestSegments = Segs
							BestBits = Bits
							break
						end
					end
					if Version ~= -1 then
						break
					end
				end
			end
		end
		if Version == -1 then
			error("QR data too long")
		end

		if BoostECC then
			for Candidate = Level + 1, 3 do
				if BestBits <= GetNumDataCodewords(Version, Candidate) * 8 then
					Level = Candidate
				end
			end
		end

		const Modules, Size, Mask = FinishRaw(Version, Level, BestSegments, ForcedMask)
		return Modules, Size, Version, Level, Mask
	else
		local Seg: buffer
		if ModeName == "Numeric" then
			Seg = MakeNumeric(Data)
		elseif ModeName == "Alphanumeric" then
			Seg = MakeAlphanumeric(Data)
		elseif ModeName == "Kanji" then
			Seg = MakeKanji(Data)
		else
			Seg = MakeBytes(Data)
		end
		return SegmentsCore(Seg, Level, MinVersion, MaxVersion, ForcedMask, BoostECC)
	end
end

@[native, checked] const function Encode(Data: buffer, Options: EncodeOptions?): (buffer, number, number)
	const Modules, Size = EncodeCore(Data, Options)
	const BlockSize, Margin = ResolveRender(if Options then Options.BlockSize else nil, if Options then Options.Margin else nil)
	const SidePx = (Size + Margin * 2) * BlockSize
	return Render(Modules, Size, BlockSize, Margin), SidePx, SidePx
end

@[native, checked] const function Matrix(Data: buffer, Options: EncodeOptions?): buffer
	const Modules = EncodeCore(Data, Options)
	return Modules
end

export const Encode = Encode
export const Matrix = Matrix
