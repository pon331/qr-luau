@[native, checked] const function KanjiValue(Codepoint: number): number
	local Lo = 0
	local Hi = KANJI_COUNT - 1
	while Lo <= Hi do
		const Mid = (Lo + Hi) // 2
		const Cp = buffer.readu16(KANJI, Mid * 4)
		if Cp == Codepoint then
			return buffer.readu16(KANJI, Mid * 4 + 2)
		end
		if Cp < Codepoint then
			Lo = Mid + 1
		else
			Hi = Mid - 1
		end
	end
	return 0
end

@[native, checked] const function BuildDataCodewords(Segments: { buffer }, Version: number, Level: number): buffer
	const Capacity = GetNumDataCodewords(Version, Level)
	const Codewords = buffer.create(Capacity)
	local Position = 0
	local Acc = 0
	local BitCount = 0

	for _, Seg in Segments do
		const Mode = buffer.readu8(Seg, SEG_MODE)
		if Mode == MODE_ECI then
			local Value = buffer.readu32(Seg, SEG_VALUE)
			Acc = Acc * 16 + MODE_ECI
			BitCount += 4
			while BitCount >= 8 do
				BitCount -= 8
				buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
				Position += 1
				Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
			end
			if Value < 0x80 then
				Acc = Acc * 256 + Value
				BitCount += 8
			elseif Value < 0x4000 then
				Acc = (Acc * 4 + 2) * 16_384 + Value
				BitCount += 16
			else
				Acc = (Acc * 8 + 6) * 2_097_152 + Value
				BitCount += 24
			end
			while BitCount >= 8 do
				BitCount -= 8
				buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
				Position += 1
				Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
			end
		else
			const Count = buffer.readu16(Seg, SEG_COUNT)
			Acc = Acc * 16 + Mode
			BitCount += 4
			const Cc = CharCountBits(Mode, Version)
			Acc = Acc * bit32.lshift(1, Cc) + Count
			BitCount += Cc
			while BitCount >= 8 do
				BitCount -= 8
				buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
				Position += 1
				Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
			end

			if Mode == MODE_NUMERIC then
				local index = 0
				while index < Count do
					const N = math.min(Count - index, 3)
					local Value = 0
					for inner_index = 0, N - 1 do
						Value = Value * 10 + buffer.readu8(Seg, SEG_DATA + index + inner_index) - 48
					end
					Acc = Acc * bit32.lshift(1, N * 3 + 1) + Value
					BitCount += N * 3 + 1
					index += N
					while BitCount >= 8 do
						BitCount -= 8
						buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
						Position += 1
						Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
					end
				end
			elseif Mode == MODE_ALPHANUMERIC then
				local index = 0
				while index + 1 < Count do
					const A = buffer.readu8(ALPHANUMERIC, buffer.readu8(Seg, SEG_DATA + index))
					const B = buffer.readu8(ALPHANUMERIC, buffer.readu8(Seg, SEG_DATA + index + 1))
					Acc = Acc * 2048 + (A * 45 + B) % 2048
					BitCount += 11
					index += 2
					while BitCount >= 8 do
						BitCount -= 8
						buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
						Position += 1
						Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
					end
				end
				if index < Count then
					Acc = Acc * 64 + buffer.readu8(ALPHANUMERIC, buffer.readu8(Seg, SEG_DATA + index)) % 64
					BitCount += 6
				end
			elseif Mode == MODE_KANJI then
				for index = 0, Count - 1 do
					const Sjis = buffer.readu16(Seg, SEG_DATA + index * 2)
					const Offset = if Sjis >= 0xE000 then 0xC140 else 0x8140
					const Value = Sjis - Offset
					Acc = Acc * 8192 + ((Value // 0x100) * 0xC0 + Value % 0x100) % 8192
					BitCount += 13
					while BitCount >= 8 do
						BitCount -= 8
						buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
						Position += 1
						Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
					end
				end
			else
				for index = 0, Count - 1 do
					Acc = Acc * 256 + buffer.readu8(Seg, SEG_DATA + index)
					BitCount += 8
					BitCount -= 8
					buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
					Position += 1
					Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
				end
			end
		end
		while BitCount >= 8 do
			BitCount -= 8
			buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
			Position += 1
			Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
		end
	end

	const CapacityBits = Capacity * 8
	const TBits = math.min(4, CapacityBits - (Position * 8 + BitCount))
	Acc *= bit32.lshift(1, TBits)
	BitCount += TBits
	if BitCount >= 8 then
		BitCount -= 8
		buffer.writeu8(Codewords, Position, bit32.band(bit32.rshift(Acc, BitCount), 255))
		Position += 1
		Acc = bit32.band(Acc, bit32.lshift(1, BitCount) - 1)
	end
	if BitCount > 0 then
		buffer.writeu8(Codewords, Position, bit32.band(bit32.lshift(Acc, 8 - BitCount), 255))
		Position += 1
		BitCount = 0
	end

	local PadByte = 0xEC
	while Position < Capacity do
		buffer.writeu8(Codewords, Position, PadByte)
		Position += 1
		PadByte = bit32.bxor(PadByte, 0xFD)
	end

	return Codewords
end

const RS_T = buffer.create(31 * 8192)

@[native, checked] const function RSRemainder(Data: buffer, DataOffset: number, DataLength: number, Degree: number): buffer
	const TOff = Degree * 8192
	const T = RS_T
	if buffer.readu8(T, TOff) == 0 then
		const GenOffset = buffer.readu16(RS_OFFSETS, Degree * 2)
		for F = 1, 255 do
			const Dest = TOff + F * 32
			for I = 0, Degree - 1 do
				buffer.writeu8(T, Dest + I, GFMul(buffer.readu8(RS_GENERATORS, GenOffset + I), F))
			end
		end
		buffer.writeu8(T, TOff, 1)
	end
	const Words = (Degree + 3) // 4
	const Result = buffer.create(Words * 4 + 4)
	const LastData = DataOffset + DataLength - 1
	for index = DataOffset, LastData do
		const Factor = bit32.bxor(buffer.readu8(Data, index), buffer.readu8(Result, 0))
		buffer.copy(Result, 0, Result, 1, Words * 4)
		if Factor ~= 0 then
			const TT = TOff + Factor * 32
			for W = 0, Words - 1 do
				buffer.writeu32(Result, W * 4, bit32.bxor(buffer.readu32(Result, W * 4), buffer.readu32(T, TT + W * 4)))
			end
		end
	end
	return Result
end

@[native, checked] const function AddECC(Data: buffer, Version: number, Level: number): buffer
	const NumBlocks = buffer.readu8(NUM_ERROR_CORRECTION_BLOCKS, Level * MAX_VERSION + Version - 1)
	const BlockECCLen = buffer.readu8(ECC_CODEWORDS_PER_BLOCK, Level * MAX_VERSION + Version - 1)
	const RawCodewords = GetNumRawDataModules(Version) // 8
	const NumShortBlocks = NumBlocks - RawCodewords % NumBlocks
	const DataLenShort = RawCodewords // NumBlocks - BlockECCLen

	const AllCodewords = buffer.create(RawCodewords)
	const EC = buffer.create(NumBlocks * BlockECCLen)
	const BlockOffsets = buffer.create(NumBlocks * 2)

	local Offset = 0
	for Block = 0, NumBlocks - 1 do
		buffer.writeu16(BlockOffsets, Block * 2, Offset)
		local DataLen = DataLenShort
		if Block >= NumShortBlocks then
			DataLen += 1
		end
		const Remainder = RSRemainder(Data, Offset, DataLen, BlockECCLen)
		buffer.copy(EC, Block * BlockECCLen, Remainder, 0, BlockECCLen)
		Offset += DataLen
	end

	local Position = 0
	for index = 0, DataLenShort - 1 do
		for Block = 0, NumBlocks - 1 do
			buffer.writeu8(AllCodewords, Position, buffer.readu8(Data, buffer.readu16(BlockOffsets, Block * 2) + index))
			Position += 1
		end
	end
	for Block = NumShortBlocks, NumBlocks - 1 do
		buffer.writeu8(AllCodewords, Position, buffer.readu8(Data, buffer.readu16(BlockOffsets, Block * 2) + DataLenShort))
		Position += 1
	end
	for index = 0, BlockECCLen - 1 do
		for Block = 0, NumBlocks - 1 do
			buffer.writeu8(AllCodewords, Position, buffer.readu8(EC, Block * BlockECCLen + index))
			Position += 1
		end
	end

	return AllCodewords
end

@[native, checked] const function DrawFormatBits(Modules: buffer, IsFunction: buffer, Size: number, Level: number, Mask: number)
	const Data = bit32.bor(buffer.readu8(LEVEL_FORMAT_BITS, Level) * 8, Mask)
	local Rem = Data
	for _ = 1, 10 do
		Rem = bit32.bxor(Rem * 2, Rem // 512 * FORMAT_GENERATOR)
	end
	const Bits = bit32.bxor(bit32.bor(Data * 1024, Rem), FORMAT_MASK)

	for index = 0, 5 do
		buffer.writeu8(IsFunction, index * Size + 8, 1)
		buffer.writeu8(Modules, index * Size + 8, if bit32.btest(bit32.rshift(Bits, index), 1) then 1 else 0)
	end
	buffer.writeu8(IsFunction, 7 * Size + 8, 1)
	buffer.writeu8(Modules, 7 * Size + 8, if bit32.btest(Bits // 64, 1) then 1 else 0)
	buffer.writeu8(IsFunction, 8 * Size + 8, 1)
	buffer.writeu8(Modules, 8 * Size + 8, if bit32.btest(Bits // 128, 1) then 1 else 0)
	buffer.writeu8(IsFunction, 8 * Size + 7, 1)
	buffer.writeu8(Modules, 8 * Size + 7, if bit32.btest(Bits // 256, 1) then 1 else 0)
	for index = 9, 14 do
		buffer.writeu8(IsFunction, 8 * Size + 14 - index, 1)
		buffer.writeu8(Modules, 8 * Size + 14 - index, if bit32.btest(bit32.rshift(Bits, index), 1) then 1 else 0)
	end

	for index = 0, 7 do
		buffer.writeu8(IsFunction, 8 * Size + Size - 1 - index, 1)
		buffer.writeu8(Modules, 8 * Size + Size - 1 - index, if bit32.btest(bit32.rshift(Bits, index), 1) then 1 else 0)
	end
	for index = 8, 14 do
		buffer.writeu8(IsFunction, (Size - 15 + index) * Size + 8, 1)
		buffer.writeu8(Modules, (Size - 15 + index) * Size + 8, if bit32.btest(bit32.rshift(Bits, index), 1) then 1 else 0)
	end
	buffer.writeu8(IsFunction, (Size - 8) * Size + 8, 1)
	buffer.writeu8(Modules, (Size - 8) * Size + 8, 1)
end

@[native, checked] const function DrawVersion(Modules: buffer, IsFunction: buffer, Size: number, Version: number)
	if Version < 7 then
		return
	end
	local Rem = Version
	for _ = 1, 12 do
		Rem = bit32.bxor(Rem * 2, Rem // 2048 * VERSION_GENERATOR)
	end
	const Bits = bit32.bor(Version * 4096, Rem)
	for index = 0, 17 do
		const A = Size - 11 + index % 3
		const B = index // 3
		const Dark = bit32.btest(bit32.rshift(Bits, index), 1)
		buffer.writeu8(IsFunction, B * Size + A, 1)
		buffer.writeu8(Modules, B * Size + A, if Dark then 1 else 0)
		buffer.writeu8(IsFunction, A * Size + B, 1)
		buffer.writeu8(Modules, A * Size + B, if Dark then 1 else 0)
	end
end

@[native, checked] const function DrawFinder(Modules: buffer, IsFunction: buffer, Size: number, CenterX: number, CenterY: number)
	for offset_y = -4, 4 do
		for offset_x = -4, 4 do
			const Dist = math.max(math.abs(offset_x), math.abs(offset_y))
			const column = CenterX + offset_x
			const row = CenterY + offset_y
			if column >= 0 and column < Size and row >= 0 and row < Size then
				buffer.writeu8(IsFunction, row * Size + column, 1)
				if Dist ~= 2 and Dist ~= 4 then
					buffer.writeu8(Modules, row * Size + column, 1)
				end
			end
		end
	end
end

@[native, checked] const function DrawAlignment(Modules: buffer, IsFunction: buffer, Size: number, CenterX: number, CenterY: number)
	for offset_y = -2, 2 do
		for offset_x = -2, 2 do
			const column = CenterX + offset_x
			const row = CenterY + offset_y
			buffer.writeu8(IsFunction, row * Size + column, 1)
			if math.max(math.abs(offset_x), math.abs(offset_y)) ~= 1 then
				buffer.writeu8(Modules, row * Size + column, 1)
			end
		end
	end
end

local DCWCacheSize = -1
local DCWList: buffer = buffer.create(0)
local DCWCount = 0

@[native, checked] const function DrawCodewords(Modules: buffer, IsFunction: buffer, Size: number, Data: buffer)
	const DataBits = buffer.len(Data) * 8
	if Size ~= DCWCacheSize or DataBits > DCWCount then
		const List = buffer.create(DataBits * 2)
		local K = 0
		const NegSize = -Size
		local Right = Size - 1
		while Right >= 1 do
			if Right == 6 then
				Right = 5
			end
			local Idx = Right
			local Step = Size
			if not bit32.btest(Right + 1, 2) then
				Idx = Right + (Size - 1) * Size
				Step = NegSize
			end
			for _ = 0, Size - 1 do
				if K == DataBits then
					break
				end
				if buffer.readu8(IsFunction, Idx) == 0 then
					buffer.writeu16(List, K * 2, Idx)
					K += 1
				end
				if K < DataBits and buffer.readu8(IsFunction, Idx - 1) == 0 then
					buffer.writeu16(List, K * 2, Idx - 1)
					K += 1
				end
				Idx += Step
			end
			if K == DataBits then
				break
			end
			Right -= 2
		end
		DCWList = List
		DCWCacheSize = Size
		DCWCount = DataBits
	end
	for ByteIdx = 0, DataBits // 8 - 1 do
		const Byte = buffer.readu8(Data, ByteIdx)
		const B8 = ByteIdx * 16
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8), bit32.rshift(Byte, 7))
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8 + 2), bit32.band(bit32.rshift(Byte, 6), 1))
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8 + 4), bit32.band(bit32.rshift(Byte, 5), 1))
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8 + 6), bit32.band(bit32.rshift(Byte, 4), 1))
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8 + 8), bit32.band(bit32.rshift(Byte, 3), 1))
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8 + 10), bit32.band(bit32.rshift(Byte, 2), 1))
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8 + 12), bit32.band(bit32.rshift(Byte, 1), 1))
		buffer.writeu8(Modules, buffer.readu16(DCWList, B8 + 14), bit32.band(Byte, 1))
	end
end
